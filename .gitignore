# Brainstorming visual companion (local only)
.superpowers/

# Supabase CLI local state (project ref, pooler connection string)
supabase/.temp/

# Scratch space for local diagnostics
.tmp/

# Scratch probes written by audit agents
# Scratch files background agents leave behind while reproducing a bug. The
# pattern is deliberately loose: two of these have already been swept into a
# commit because the name did not match a tighter one.
src/**/__tmp*
src/**/*probe*
src/**/zz*
src/**/__audit_*
