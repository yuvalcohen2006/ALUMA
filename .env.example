# Supabase connection (client-side, Vite exposes only VITE_* vars to the browser).
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
#   VITE_SUPABASE_URL              = "Project URL"
#   VITE_SUPABASE_PROJECT_ID       = the ref in that URL (…//<PROJECT_ID>.supabase.co)
#   VITE_SUPABASE_PUBLISHABLE_KEY  = the "anon" / "public" key (safe to ship to the browser)
#
# The app reads these at startup (src/integrations/supabase/client.ts). If they are
# missing the Supabase client cannot be created and the whole app fails to mount
# (blank white screen), so all three must be present before `npm run dev`.

VITE_SUPABASE_URL=https://jzqayfllojeqivwbbuyf.supabase.co
VITE_SUPABASE_PROJECT_ID=jzqayfllojeqivwbbuyf
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# The placeholder catalogue and magazine fill the site ONLY while the database
# is empty, so the design is judgeable before real content exists. Any real
# product or article takes over automatically — you never have to remember to
# turn this off. Set it to 0 if you specifically want to see the empty state.
VITE_USE_DEMO_DATA=
