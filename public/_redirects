# Cloudflare Pages redirects.
#
# ORDER MATTERS: every 301 must sit ABOVE the catch-all, or the SPA fallback
# swallows it and the rule never fires.
#
# These catch crawlers and people arriving on an old URL. The same moves also
# exist as in-app <Navigate> routes in src/routes.tsx, which is what handles
# link clicks inside the SPA — those never reach the edge at all.

# Materials + magazine merged into "שווה לדעת". The material DETAIL pages stay
# live, so /materials/* must NOT be caught here.
/materials       /journal      301
/en/materials    /en/journal   301
/blog            /journal      301
/en/blog         /en/journal   301
/blog/*          /journal/:splat      301
/en/blog/*       /en/journal/:splat   301

# Briefly-lived URLs from the restructure that was rolled back.
/about        /story      301
/en/about     /en/story   301
/consult      /questionnaire      301
/en/consult   /en/questionnaire   301
/diy/scene    /designer   301
/diy/fabric   /fabric     301
/diy/ar       /ar         301

# Retired page
/before-after     /projects     301
/en/before-after  /en/projects  301

# Duplicate routes collapsed onto one canonical URL each
/auth        /club/auth          301
/account     /club/dashboard     301
/en/auth     /en/club/auth       301
/en/account  /en/club/dashboard  301

# SPA fallback — must stay last.
/*  /index.html  200
